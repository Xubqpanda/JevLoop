{
  "compilerOptions": {
    "target": "ES2023",
    "lib": ["ES2023"],
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "types": ["node"],

    /* Node 22 原生跑 .ts 靠类型剥离，不做编译。
       所以只允许可擦除语法，且相对导入必须带 .ts 扩展名。 */
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "noEmit": true,

    /* web/ 是浏览器直接加载的纯 JS（无构建步骤，见 web/markdown.js 文件头）。
       让 TS 把它读进程序，是为了**测试能 import 它** —— 不读的话是 TS7016
       「找不到声明文件」，于是 `web/` 一直没有测试，而它恰恰是唯一
       用户直接看到的代码（2026-09-21 的死循环就是这么漏出去的）。
       `checkJs` 不打开：那些文件用 `document`，而这里没有 DOM lib，
       打开会淹在「找不到 document」里，真正的问题反而看不见。 */
    "allowJs": true,

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": [
    "src/**/*.ts",
    "examples/**/*.ts",
    "bin/**/*.ts",
    "tests/**/*.ts",
    "bench/**/*.ts",
    "scripts/**/*.ts",
    /* 实验台的脚本也要被类型检查 —— 七个人写的东西如果只有自己能跑，
       那和没有门禁一样。见 experiments/README.md。 */
    "experiments/**/*.ts",
    "web/**/*.js"
  ]
}
